{
  "manifest_version": 3,
  "name": "Falcon Loader",
  "description": "try to take over the world!",
  "version": "1.0.0",
  "action": {},
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://sandbox.moomoo.io/*",
    "https://falcon-loader.onrender.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/remove.js-MucqT9jB.js"
      ],
      "matches": [
        "*://sandbox.moomoo.io/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://sandbox.moomoo.io/*"
      ],
      "resources": [
        "assets/remove.js-MucqT9jB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
